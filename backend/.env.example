# Backend environment template. Copy to .env and adjust.
# The live Testnet deployment values are recorded in docs/DEPLOYMENT.md.

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:4173
# Optional bearer token protecting POST /api/ingest/run (empty = open)
ADMIN_TOKEN=

# Database
# DB_PATH=data/regulation-reckoning.db   (default)

# Stellar / Horizon (Testnet)
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed Soroban contract (live Testnet deployment)
BOUNTY_CONTRACT_ID=CC2YEX6U7HV7L7L45HVOLVWGN2POARLPS3XICZS6KQH5Y52OTAHK7LVY
DEMO_TOKEN_ID=CCOAF5DIHLO4457S6EGQYSLXGGDRQPTO42DU6N5KVH4M2MSA2VDW2NB4
# Public admin address. The admin SECRET is never configured here.
BOUNTY_ADMIN_ADDRESS=GBRVOQSLP32BGOCYA56DCTM5PUQWW7YLBBAKVXBHDTJ6SNKVLGMWFRQI

# Ingestion
GITHUB_REPO=
GITHUB_TOKEN=
INGEST_ON_START=true
REINGEST_ON_START=false

# Indexer
INDEXER_ENABLED=true
INDEXER_INTERVAL_MS=15000
INDEXER_START_LEDGER=0

# Observability
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120