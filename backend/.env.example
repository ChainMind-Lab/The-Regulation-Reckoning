# Backend environment template. Copy to .env and adjust.
# The canonical live Testnet deployment values are recorded in docs/DEPLOYMENT.md.

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:4173
# Trust X-Forwarded-For (set true when behind a reverse proxy such as nginx).
TRUST_PROXY=false
# Optional bearer token protecting POST /api/ingest/run (empty = open)
ADMIN_TOKEN=

# Database
# DB_PATH=data/regulation-reckoning.db   (default)

# Stellar / Horizon (Testnet)
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Deployed Soroban contracts (live Testnet deployment — see docs/DEPLOYMENT.md)
BOUNTY_CONTRACT_ID=CB4OI57YRKLAIX2RGFS7DX3GIGEST4MSI447VAJPRCBCNFUHWLWLQLWT
DEMO_TOKEN_ID=CB7NFW2WD3FXKBYANZX7J3FO6PBST2H3IE6SPHXHSWIQESII2P2A6Y6P
CONTRIBUTOR_REGISTRY_ID=CC53MJDM5M76GMZONKC56ONW4MM74MX3KF4LSXMWTRE7W66RASDP4W7Q
# Public admin address. The admin SECRET is never configured here.
BOUNTY_ADMIN_ADDRESS=GB2OVPTEO2BYRRRRWNRPZZOC3VW77IQDXJPBY2WYV2MXSU7C5HQDZ6E6

# Ingestion
GITHUB_REPO=
GITHUB_TOKEN=
INGEST_ON_START=true
REINGEST_ON_START=false

# Indexer
INDEXER_ENABLED=true
INDEXER_INTERVAL_MS=15000
# 0 = scan only the last ~1000 ledgers (fresh installs start empty).
# Use the deployment ledger to backfill full history (docs/DEPLOYMENT.md).
INDEXER_START_LEDGER=4588860

# Observability
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
