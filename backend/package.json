{
  "name": "regulation-reckoning-api",
  "version": "1.0.0",
  "private": true,
  "description": "Express API backend for The Regulation Reckoning — Soroban bounty platform (Stellar Testnet)",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "ts-node-dev --transpile-only src/scripts/run-ingest.ts",
    "index": "ts-node-dev --transpile-only src/scripts/run-index.ts",
    "lint": "eslint src test --ext .ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "audit": "npm audit --audit-level=high",
    "e2e": "node e2e/testnet-e2e.mjs"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^16.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.18.2",
    "vitest": "^4.1.6"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
