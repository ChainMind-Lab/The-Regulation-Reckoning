# ── Frontend (Vite) ──────────────────────────────────────────────
# URL of the backend API server. OPTIONAL — leave it commented out:
#   * `npm run dev` defaults to http://localhost:3001, and
#   * production builds default to the same origin (the bundled nginx proxies /api).
# Uncomment and set it only when the API lives on a different origin.
#
# NOTE: `docker compose` reads this file for variable substitution, so setting it
# here would bake that URL into the Docker-built frontend. Leave it unset for Docker.
# VITE_API_URL=http://localhost:3001

# ── Backend ──────────────────────────────────────────────────────
# Port the Express server listens on
PORT=3001

# Stellar Horizon endpoint (Testnet)
HORIZON_URL=https://horizon-testnet.stellar.org

# Allowed frontend origin for CORS
FRONTEND_URL=http://localhost:4173

# Trust X-Forwarded-For (set when running behind a reverse proxy such as nginx).
# Required for rate limiting to key on real client IPs.
TRUST_PROXY=false

# Optional bearer token protecting POST /api/ingest/run (empty = open)
ADMIN_TOKEN=

# ── Soroban / Smart Contracts (live Testnet deployment) ──────────
# Deployed bounty contract (see docs/DEPLOYMENT.md)
BOUNTY_CONTRACT_ID=CALVQ2APRIRT6FI3OAQEFSHA6ZSKO7T6KQTEGET6PJB4H4KX5Q4GFDNR

# Deployed RRD demo token (Soroban Asset Contract)
DEMO_TOKEN_ID=CCXALNR42ZJSHUXTB2MBVGRVEDPTKT3RTYYLCOKID55A2UCPKIBOJHBO

# Deployed contributors registry contract (inter-contract communication)
CONTRIBUTOR_REGISTRY_ID=CBIEGFLS22QNFUS6LBKUEY3OGBI3YP625G4PIWAM5CMPP6YXIFQJXJAX

# Public bootstrap signer address. The admin/bootstraps SECRET is NEVER set here.
BOUNTY_ADMIN_ADDRESS=GBK5GVI2XLAS2JJLXYLONMKLA5PI2EUPE5UAQDSXCLPWHX23M76TPAKL

# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Ingestion / Indexer ──────────────────────────────────────────
# Optional GitHub repo to ingest open issues from (empty = use seed data)
GITHUB_REPO=
GITHUB_TOKEN=

# Ingest on boot when tables are empty (true/false)
INGEST_ON_START=true
# Force re-ingest on every boot
REINGEST_ON_START=false

# Poll contracts for new events (true/false) and how often (ms)
INDEXER_ENABLED=true
INDEXER_INTERVAL_MS=15000
# Ledger to start indexing from. IMPORTANT: 0 means "only scan the last ~1000
# ledgers", which leaves the dashboard empty on a fresh install. Use the
# deployment's ledger (see docs/DEPLOYMENT.md) to index the full history.
INDEXER_START_LEDGER=4621636

# ── Observability ────────────────────────────────────────────────
LOG_LEVEL=info
# Per-IP rate limit: window ms + max requests
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
